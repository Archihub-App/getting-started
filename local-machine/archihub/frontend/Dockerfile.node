FROM node:22-alpine

WORKDIR /app

# `build/` must contain a Next.js standalone output: run `npm run build:standalone`
# in upgrade_front and copy the resulting `.next/standalone` contents here
# (server.js, .next/, node_modules/, public/, etc.) before building this image.
COPY build .

ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

EXPOSE 3000

CMD ["node", "server.js"]
