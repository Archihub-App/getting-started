# ArchiHUB - network installation settings for docker-compose.yml.
#
# Copy this file to `.env` on every machine of the installation. The secrets
# and addresses must be the same on all of them. Generate the secrets once:
#
#   JWT_SECRET_KEY, NODE_TOKEN, passwords:  openssl rand -hex 32
#   FERNET_KEY:                             openssl rand -base64 32 | tr '+/' '-_'
#
# Keep FERNET_KEY once the instance is in use: values encrypted with it (AI
# provider keys, among others) cannot be read with a different one.

# ---- Instance ----
# Names the MongoDB database and the search index prefix: archihub-<name>.
ENVIRONMENT_NAME='prod'
# PROD or DEV.
FASTAPI_ENV='PROD'
# Port the backend listens on and is published at. The frontend's
# config.json `URL_API` must point at it.
BACKEND_PORT='11000'
# Public address of the frontend, used in password-reset links.
REDIRECT_URL='http://localhost'
# uvicorn worker processes.
UVICORN_WORKERS=4
# Concurrent jobs per Celery worker.
CELERYD_CONCURRENCY=1

# ---- Secrets ----
JWT_SECRET_KEY='__GENERATE__'
FERNET_KEY='__GENERATE__'
NODE_TOKEN='__GENERATE__'

# ---- MongoDB (../mongoCluster) ----
# The replica set members, comma separated, without ports.
MONGO_HOSTS='mongo1.example.org,mongo2.example.org'
MONGO_PORT=27017
MONGO_RS='rs0'
MONGO_INITDB_ROOT_USERNAME='admin'
MONGO_INITDB_ROOT_PASSWORD='__GENERATE__'

# ---- Elasticsearch ----
# With the scheme, without the port.
ELASTIC_DOMAIN='http://elastic.example.org'
ELASTIC_PORT=9200
ELASTIC_USER='elastic'
ELASTIC_PASSWORD='__GENERATE__'
# Only for HTTPS: the CA certificate, placed in ./elastic_certs.
# ELASTIC_CERT='/app/elastic_certs/ca.crt'

# ---- Redis ----
# Application machine: the address processing nodes use to reach Redis, or
# leave unset when there are none.
# REDIS_BIND='192.168.1.10'
# Processing node: the application machine's address.
# REDIS_HOST='192.168.1.10'

# ---- Processing node only ----
# The application machine's backend.
# MASTER_HOST='http://192.168.1.10:11000'

# ---- Shared storage ----
# The same directories on every machine (e.g. an NFS mount).
USERFILES_PATH='/mnt/archihub/userfiles'
WEBFILE_PATH='/mnt/archihub/webfiles'
UPLOAD_PATH='/mnt/archihub/original'
TEMPORAL_PATH='/mnt/archihub/temporal'

# Plugin settings do not belong here: each plugin reads its own
# local-machine/archihub/backend/archihub/plugins/<plugin>/.env
# (see the plugin's .env.example).
